# State: SQLite file, committed back by the workflow. Default is data/radar.db.
# DB_PATH=data/radar.db

# Search
BRAVE_API_KEY=      # optional: empty means DuckDuckGo only
RELIEFWEB_APPNAME=  # optional: pre-approved ReliefWeb appname for Nigeria jobs

# LLM (at least one required)
GROQ_API_KEY=
GEMINI_API_KEY=     # fallback; strongly recommended
# GEMINI_MODEL=gemini-2.5-flash

# Email
SMTP_USER=          # your gmail address
SMTP_APP_PASSWORD=  # Google app password, not your account password
DIGEST_TO=          # defaults to SMTP_USER if empty

# Optional tuning
# DIGEST_SIZE=8
# DEVFUND_SLOTS=3
# MIN_SCORE=40
# SEND_EMPTY_DIGEST=false
