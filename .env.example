# Postgres (existing baseline-LLMOps instance, separate database)
PG_HOST=            # GCP node external IP (never commit the real value)
PG_PORT=30432
PG_USER=appuser
PG_PASSWORD=
PG_DATABASE=opportunity_radar

# Search
BRAVE_API_KEY=

# LLM
GROQ_API_KEY=
GEMINI_API_KEY=     # fallback; strongly recommended

# Email
SMTP_USER=          # your gmail address
SMTP_APP_PASSWORD=  # Google app password, not your account password
DIGEST_TO=          # defaults to SMTP_USER if empty

# Optional tuning
# DIGEST_SIZE=8
# MIN_SCORE=40
# SEND_EMPTY_DIGEST=false
